<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaUI.DataGrid.Pagination.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaUI.DataGrid.Pagination.Views.MainWindow"
		xmlns:local="using:AvaloniaUI.DataGrid.Pagination"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AvaloniaUI.DataGrid.Pagination">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

	<Design.DataContext>
		<local:PaginatedDataGrid/>
	</Design.DataContext>
	

	<Grid DockPanel.Dock="Top">

		<Grid.RowDefinitions>
			<RowDefinition Height="600" />	
			<RowDefinition Height="Auto" />			
		</Grid.RowDefinitions>

		<DataGrid x:Name="positionsHistoryGrid"
	        Grid.Row="0"
			ItemsSource="{Binding PositionHistory}"
		    AutoGenerateColumns="True"
		    IsReadOnly="True">
		</DataGrid>
		
		<local:PaginatedDataGrid x:Name="paginatedDataGrid"
											PageSize="20"
											NumPageButtons="5" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
		
		<Button Grid.Row="1" Content="Generate Trade History" Command="{Binding GenerateTradeHistoryCommand}" VerticalAlignment="Bottom"/>
		
	</Grid>

</Window>
